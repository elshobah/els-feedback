# --- Application ---------------------------------------------------------
# Public URL of your instance (auth, emails and OAuth callbacks depend on it).
BASE_URL=https://feedback.zidcloud.com

# Session signing + encryption key. MUST be >= 32 chars.
# Generate with: openssl rand -base64 32
SECRET_KEY=P

# Published image tag to run. Pin to a release (e.g. 0.10.6) in production.
QUACKBACK_TAG=latest

# Unused behind a reverse proxy (Dokploy/Traefik): the app publishes no host
# port, Traefik reaches it on the container's internal port 3000. Kept only for
# a standalone `docker compose` run that re-adds a `ports:` mapping.
# APP_PORT=3000

# --- PostgreSQL (internal `postgres` service) ----------------------------
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- Object storage: Cloudflare R2 (external) ----------------------------
# This stack has no bundled MinIO service — R2 is used instead, so every S3_*
# value below is passed straight through to the app by docker-compose.prod.yml.
#
# Create the bucket and an R2 API token (Object Read & Write) in the Cloudflare
# dashboard, then fill in the key pair below.
S3_ENDPOINT=
S3_BUCKET=els-feedback
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# R2 needs path-style addressing. Do NOT set this to false.
S3_FORCE_PATH_STYLE=true

# Optional. Set only if the bucket is exposed through an R2 custom domain or
# CDN. Leave blank for a PRIVATE bucket — uploads are then served via
# BASE_URL/api/storage using presigned redirects, which works either way.
# S3_PUBLIC_URL=https://files.example.com

# Optional. Stream uploads/downloads through the app instead of letting the
# browser talk to R2 directly. Default is false (direct), which requires a CORS
# policy on the R2 bucket allowing your BASE_URL origin. Set to true to skip
# CORS setup entirely at the cost of proxying the bytes through your server.
S3_PROXY=true

# --- Email (required for invites, magic links, notifications) ------------
# SMTP (works with any provider). Leave blank to log emails to the console.
EMAIL_SMTP_HOST=smtp.zeptomail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=emailapikey
EMAIL_SMTP_PASS=
EMAIL_FROM=Zidcloud <noreply@notif.zidcloud.com>
# Or use Resend instead of SMTP:
# EMAIL_RESEND_API_KEY=

# --- AI (optional) -------------------------------------------------------
# Enables summaries, duplicate detection, feedback extraction, etc.
OPENAI_API_KEY=sk
OPENAI_BASE_URL=https://router.elshobah.com/v1

# --- Google sign-in ------------------------------------------------------
# NOT configurable here. Social-login credentials (auth_google) are per-tenant
# and ALWAYS stored in the database — no environment variable is ever read for
# them. Configure the client ID/secret in the admin UI after first boot:
#   Admin → Settings → Security → Authentication
# Google OAuth redirect URI to register in Google Cloud Console:
#   ${BASE_URL}/api/auth/callback/google
